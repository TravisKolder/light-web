# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No service_role key, ever (Travis, 2026-11-24). Public passport files are
# signed with the anon key, which storage policy limits to files the public
# views already expose (migration 020).
