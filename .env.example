# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, SERVER ONLY (never prefix with NEXT_PUBLIC_). Lets the public
# passport show files that the public views expose (backlog 27d2): the
# server re-checks each file with the anon key, then uses this key only to
# sign a 60-second link and streams the file. Leave empty and the public page
# simply shows no file links. Supabase -> Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
